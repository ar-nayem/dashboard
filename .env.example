# Copy to .env and fill in. Never commit .env — it is gitignored.
# Everything here is read server-side only and never reaches the browser.
#
# Easiest path: `npm run setup:keys` prompts for each value and writes .env
# with chmod 600, reading the Google JSON and Apple .p8 straight off disk so
# their newlines are escaped correctly.
#
# BASE_PATH: set to "/dashboard" in production when serving under a subpath.
# Leave unset locally so `npm run dev` serves from "/".

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

DATABASE_URL="file:./dev.db"

# Signs the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this logs every existing session out immediately.
SESSION_SECRET=""

# scrypt hash of the single app password, in "salt:hash" form.
# Set it with `npm run set:password` — it prompts without echoing and writes
# the hash here, so the password never lands in your shell history.
APP_PASSWORD_HASH=""

# Bearer token for GET /api/cron. Without it the endpoint refuses every
# request, so scheduled syncing stays off until you set it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Integrations (all optional — each one is skipped until its keys are present)
# ---------------------------------------------------------------------------

# --- GitHub: commit activity per repo → Projects ---------------------------
# github.com/settings/personal-access-tokens
# Fine-grained token, read-only on Contents + Metadata.
GITHUB_TOKEN=""

# --- Google Analytics + Search Console → Projects --------------------------
# One service account covers both.
#  1. Google Cloud console → IAM → Service Accounts → create
#  2. Keys → Add key → JSON → download
#  3. Enable "Google Analytics Data API" and "Search Console API"
#  4. GA4 admin → Property access → add the service account email as Viewer
#  5. Search Console → Settings → Users → add the same email
# Paste the whole JSON file as ONE line below.
GA_SERVICE_ACCOUNT_JSON=""

# --- App Store Connect: installs + proceeds → Projects ---------------------
# App Store Connect → Users and Access → Integrations → App Store Connect API
ASC_ISSUER_ID=""
ASC_KEY_ID=""
# Contents of the .p8 file as one line, newlines written as \n.
# Apple lets you download it exactly once.
ASC_PRIVATE_KEY=""
# App Store Connect → Payments and Financial Reports → the number by your name
ASC_VENDOR_NUMBER=""

# --- RevenueCat: MRR, subscriptions, trials → Projects ---------------------
# RevenueCat → Project settings → API keys → v2 secret key (sk_…)
REVENUECAT_API_KEY=""

# --- Stripe: successful charges → Finance income ---------------------------
# Stripe → Developers → API keys.
# A RESTRICTED key with read access to Charges is enough — prefer that over
# a full secret key.
STRIPE_SECRET_KEY=""

# --- YouTube: subscribers + views → Video ----------------------------------
# Google Cloud console → enable "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=""
# YouTube Studio → Settings → Channel → Advanced settings (starts with UC)
YOUTUBE_CHANNEL_ID=""

# --- Apple Health: weight, HR, HRV, steps → Health -------------------------
# Apple has no server API for Health, so your phone pushes to this app.
# Invent any long random string; the iOS Shortcut sends it as the
# x-webhook-secret header when POSTing to /api/health-webhook.
HEALTH_WEBHOOK_SECRET=""
